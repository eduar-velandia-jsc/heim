# Heim – configuración para Hostinger (Apache)

Options -MultiViews
RewriteEngine On
RewriteBase /

# Forzar HTTPS (activa estas dos líneas cuando el certificado SSL del dominio esté activo en hPanel)
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# SPA: cualquier ruta que no sea un archivo real (/proyectos, /legal…) la resuelve index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Caché: los archivos con hash de /assets/ y las imágenes pueden guardarse mucho tiempo;
# index.html nunca, para que cada publicación se vea al instante.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|svg|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
